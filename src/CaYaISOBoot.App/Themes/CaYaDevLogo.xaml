                <!-- Red: A harfi (2) — outer + inner triangle (EvenOdd) -->
                <GeometryDrawing Brush="{StaticResource LogoRedBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry FillRule="EvenOdd"
                                      Figures="M165.49,18.89l-1.61-4.21L158.29,0h-19.22l-3.9,15.61-1.11,4.43-4.17,16.65h4.94l6.86-13.08,6.16,2.88h4.22l6.17-3.5,9.1,13.7h4.94l-6.79-17.81ZM149.96,20.5l-5.65-1.87,4.87-9.3,5.97,8.99-5.19,2.17Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- White: D harfi gövdesi -->
                <GeometryDrawing Brush="{StaticResource LogoWhiteBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M174.93,0 L166.64,0 L178.65,36.78 L184.39,36.7 L174.93,0 Z" />
