                        <PathGeometry Figures="M243.91,36.7 L227.66,36.7 L221.91,36.78 L209.91,0 L218.19,0 L218.19,0.01 L239.17,0 L237.85,3.22 L219.83,6.36 L222.09,15.13 L237.15,15.13 L237.38,19.11 L223.73,21.48 L226.04,30.41 L241.59,33.12 L243.91,36.7 Z" />
