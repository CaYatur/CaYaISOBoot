<Window x:Class="CaYaISOBoot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaYaISOBoot"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasGradientBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Status pill row -->
            <RowDefinition Height="*" />
            <!-- Disks + details -->
            <RowDefinition Height="Auto" />
            <!-- Action bar -->
            <RowDefinition Height="170" />
            <!-- Logs -->
        </Grid.RowDefinitions>

        <!-- =====================  Header  ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource CaYaDevLogo}"
                           Height="22"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Width="1"
                            Background="{StaticResource BorderBrushSoft}"
                            Margin="0,2,16,2" />
                    <TextBlock Text="CaYaISOBoot"
                               Style="{StaticResource HeadlineText}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Native Multi-ISO USB Boot System"
                           Style="{StaticResource SubheadText}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource BrandRedBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- =====================  Install prerequisite banner  ===================== -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Kurulum durumu"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontWeight="Medium"
                           Margin="0,0,18,0"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding InstallPrerequisiteText}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>
        </Border>

        <!-- =====================  Disk list + details  ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Disk list card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="USB diskler"
                                   Style="{StaticResource SectionTitleText}" />
                        <Border Grid.Column="1"
                                Background="{StaticResource PanelAltBrush}"
                                CornerRadius="999"
                                Padding="8,2">
                            <TextBlock Text="{Binding Disks.Count}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Disks}"
                             SelectedItem="{Binding SelectedDisk}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Header: model + size + safety dot -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding HeaderText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                Background="{StaticResource PanelAltBrush}"
                                                CornerRadius="999"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Safety.Summary}"
                                                       Foreground="{StaticResource BrandRedBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <!-- Other partitions -->
                                    <ItemsControl ItemsSource="{Binding OtherPartitions}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CanvasAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding DisplayLine}"
                                                               Foreground="{StaticResource DimTextBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Disk ayrıntıları"
                               Style="{StaticResource SectionTitleText}"
                               Margin="0,0,0,16" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Cihaz"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedDisk.HeaderText, TargetNullValue=-}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Text="Fiziksel disk"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedDisk.Storage.DiskNumber, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Text="Sürücü harfi"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedDisk.DriveLetter, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Text="Kapasite"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedDisk.PhysicalCapacityText, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="4" Text="Boş alan"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding SelectedDisk.FreeSpaceText, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="5" Text="Dosya sistemi"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding SelectedDisk.FileSystem, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="6" Text="BusType"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       Text="{Binding SelectedDisk.Storage.BusType, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="7" Text="Removable"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10" />
                            <TextBlock Grid.Row="7" Grid.Column="1"
                                       Text="{Binding SelectedDisk.IsRemovable, TargetNullValue=-}"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="8" Text="Güvenlik"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,12,10"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Row="8" Grid.Column="1"
                                       Text="{Binding SelectedDisk.Safety.DetailText, TargetNullValue=Disk seçilmedi.}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,0,0,10" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- =====================  Action bar  ===================== -->
        <Grid Grid.Row="3" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Yenile" Command="{Binding RefreshCommand}" />
                <Button Content="Dry Run" Command="{Binding DryRunCommand}" />
                <Button Content="Güvenli Kur" Command="{Binding InstallCommand}" />
                <Button Content="USB'yi Yapılandır"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CleanInstallCommand}" />
                <Button Content="Boot Motorunu Güncelle" Command="{Binding UpdateBootEngineCommand}" />
                <Button Content="ISO Klasörü" Command="{Binding OpenIsoFolderCommand}" />
                <Button Content="Logları Aç" Command="{Binding OpenLogsCommand}" />
                <Button Content="Güvenli Çıkar" Command="{Binding SafeEjectCommand}" />
            </WrapPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="İşlem ilerlemesi"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,0,0,6" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}" />
            </StackPanel>
        </Grid>

        <!-- =====================  Logs  ===================== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Etkinlik kaydı"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,8" />
                <ListBox Grid.Row="1"
                         Style="{StaticResource LogListBox}"
                         ItemsSource="{Binding LogLines}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
